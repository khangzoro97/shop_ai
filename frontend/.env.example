# Copy to .env and fill in real values. Contact buttons stay hidden while these are empty.
VITE_ZALO_PHONE=
VITE_CONTACT_EMAIL=

# Business details for the footer (hộ kinh doanh or company). Each line stays hidden while empty.
VITE_BUSINESS_NAME=
VITE_BUSINESS_TAX_ID=
VITE_BUSINESS_ADDRESS=

# Free trial offer shown on the home page (number of photos). Set to 0 to remove the offer.
VITE_FREE_TRIAL_IMAGES=5
