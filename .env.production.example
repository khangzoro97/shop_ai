# Copy to .env on the server (never commit the real file) and fill in.

# Domain pointing to this server; Caddy issues the HTTPS certificate for it.
DOMAIN=fortfio.vn

# Generate with: openssl rand -base64 32
DB_PASSWORD=
JWT_SECRET=

# Admin account created on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# fal.ai key; empty = mock AI (no real images).
FAL_KEY=

# Storage: "local" (server disk) or "s3" (Cloudflare R2 / Amazon S3).
STORAGE_TYPE=local
STORAGE_PUBLIC_URL=/files
# For R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto,
# STORAGE_PUBLIC_URL=https://media.fortfio.vn (bucket public domain)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Error monitoring (sentry.io project DSN); empty = off.
SENTRY_DSN=

# Shown on the website (built into the frontend).
VITE_ZALO_PHONE=
VITE_CONTACT_EMAIL=
VITE_FREE_TRIAL_IMAGES=5
